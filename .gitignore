# Local reference copies of sibling repositories.
cauldron/

# Compiled monitor binary — `go build ./cmd/iscc-monitor` emits it at the repo
# root (and in the command dir); never commit the 15MB artifact.
/iscc-monitor
/cmd/iscc-monitor/iscc-monitor

# Local secrets / state — never commit (public-repo safety).
.env
.env.*
**/auth.json
*.db
*.sqlite
*.sqlite3

# Documentation site build output and its Python environment (pyproject.toml).
/site/
/.venv/

# Local agent tooling and the development container. Of .claude/, only the specs are part of
# the repository: the decision records, the product requirements, the design and the
# verifier-key oracle that the Go tests port.
.claude/*
!.claude/adr/
!.claude/prd/
!.claude/design/
!.claude/derive_vkey.py
.devcontainer/
